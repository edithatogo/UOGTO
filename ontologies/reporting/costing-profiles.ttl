<https://w3id.org/uogto/costing-reporting> a owl:Ontology ;
    rdfs:label "Costing reporting reconciliation snapshot" ;
    dcterms:date "2026-11-08"^^xsd:date ;
    dcterms:description "Bounded high-recall primary-source web review. This is not a registered systematic review or a claim of global exhaustiveness; national HTA manuals, specialty extensions and translations require continuing curation." ;
    dcterms:source <https://github.com/edithatogo/standards_check/tree/d1f1137edfa5375e0225ca2216903ce5583a44f0/reconciliations/costing> ;
    rdfs:comment "Editorial semantic mappings preserve source identities. They do not replace official wording, establish consensus, supply a checklist score or prove methodological, computational or empirical validity." ;
    owl:imports <https://w3id.org/uogto/packs/costing-valuation> ;
    owl:versionInfo "0.1.0" .

<https://w3id.org/uogto/costing-reporting/mapping/agreedt-2018-1.1-study-scope> a cost:RequirementMapping ;
    cost:mappedConcept <https://w3id.org/uogto/costing-reporting/domain/study-scope> ;
    cost:mappingRationale "Editorial topic association from the identified source item; does not assert equivalence, complete wording or automatic compliance." ;
    cost:mappingRelation "covers_topic" ;
    cost:sourceRequirement <https://w3id.org/uogto/costing-reporting/requirement/agreedt-2018-1.1> ;
    cost:validationStatus "editorial_mapping_review_required" .

