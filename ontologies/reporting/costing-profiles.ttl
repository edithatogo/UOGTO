<https://w3id.org/uogto/costing-reporting/domain/ai-intervention> a cost:ReportingDomain ;
    rdfs:label "Ai intervention" ;
    skos:definition "AI intervention role, deployment, updates, validation and economic consequences." .

<https://w3id.org/uogto/costing-reporting/domain/environment> a cost:ReportingDomain ;
    rdfs:label "Environment" ;
    skos:definition "Resource/emission inventory, physical effects and optional valuation." .

<https://w3id.org/uogto/costing-reporting/instrument/advishe-2016> a cost:ReportingInstrument ;
    rdfs:label "Assessment of the Validation Status of Health-Economic decision models" ;
    skos:definition "Reports validation efforts and outcomes for conceptual models, inputs, software and results. Useful for evidence-backed validation records, separate from claims that a model is validated merely because a checklist is complete." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/advishe-2016> ;
    cost:instrumentKind "validation_reporting_instrument" .

<https://w3id.org/uogto/costing-reporting/instrument/agreedt-2018> a cost:ReportingInstrument ;
    rdfs:label "Alignment in Reporting Economic Evaluations of Diagnostic Tests and Biomarkers" ;
    skos:definition "Diagnostic-strategy economic reporting across the testing and subsequent management pathway. Especially relevant to screening: failed samples, retesting, delays, downstream management, incidental findings and family effects. Not newborn-screening-specific." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/agreedt-2018> ;
    cost:instrumentKind "reporting_guideline" .

<https://w3id.org/uogto/costing-reporting/instrument/ahpcs-4-2> a cost:ReportingInstrument ;
    rdfs:label "Australian Hospital Patient Costing Standards" ;
    skos:definition "Australian patient-level hospital costing standard, business rules and service-specific guidance. Preserve reconciliation and in-scope allocation obligations as an optional jurisdiction profile, distinct from manuscript reporting." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/ahpcs-4-2> ;
    cost:instrumentKind "sector_costing_standard" .

<https://w3id.org/uogto/costing-reporting/instrument/bmj-economic-1996> a cost:ReportingInstrument ;
    rdfs:label "BMJ Economic Evaluation Working Party guidelines" ;
    skos:definition "Historical author/referee/editor guidance. Retain provenance and legacy mappings; current general reporting should use CHEERS 2022." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/bmj-economic-1996> ;
    cost:instrumentKind "historical_reporting_review_guidance" .

<https://w3id.org/uogto/costing-reporting/instrument/chec-2005> a cost:ReportingInstrument ;
    rdfs:label "Consensus on Health Economic Criteria" ;
    skos:definition "Methodological appraisal for economic evaluations in systematic reviews. Use separate appraisal assertions; reporting presence alone cannot establish appropriateness." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/chec-2005> ;
    cost:instrumentKind "appraisal_instrument" .

<https://w3id.org/uogto/costing-reporting/instrument/cheers-2013> a cost:ReportingInstrument ;
    rdfs:label "CHEERS original statement" ;
    skos:definition "Retain only for historical documents and migration; CHEERS 2022 supersedes this edition." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/cheers-2013> ;
    cost:instrumentKind "historical_reporting_guideline" .

<https://w3id.org/uogto/costing-reporting/instrument/cheers-2022> a cost:ReportingInstrument ;
    rdfs:label "Consolidated Health Economic Evaluation Reporting Standards" ;
    skos:definition "General health-economic reporting, including cost-only analyses; excludes budget-impact analysis and constrained optimisation. Replaces CHEERS 2013. Reporting completeness is not methodological quality or a validated numerical score." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/cheers-2022> ;
    cost:instrumentKind "reporting_guideline" .

<https://w3id.org/uogto/costing-reporting/instrument/cheers-ai-2024> a cost:ReportingInstrument ;
    rdfs:label "CHEERS for Interventions That Use Artificial Intelligence" ;
    skos:definition "Economic evaluations of interventions using AI: 28 inherited CHEERS items, eight elaborations and ten additional items. Applies when the intervention uses AI, not simply because an analyst used AI. Item-level mapping remains pending full checklist verification." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/cheers-ai-2024> ;
    cost:instrumentKind "reporting_guideline_extension" .

<https://w3id.org/uogto/costing-reporting/instrument/cheers-voi-2023> a cost:ReportingInstrument ;
    rdfs:label "CHEERS Value of Information" ;
    skos:definition "Use for VOI accompanying economic evaluation. Six supplemental items S1-S6 cover estimation, evidence, parameter groups, proposed research, simulated data and research costs; several inherited CHEERS items are elaborated. Do not calculate a total item count from inconsistent secondary descriptions." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/cheers-voi-2023> ;
    cost:instrumentKind "reporting_guideline_extension" .

<https://w3id.org/uogto/costing-reporting/instrument/coi-appraisal-2023> a cost:ReportingInstrument ;
    rdfs:label "Consensus checklist for critical appraisal of cost-of-illness studies" ;
    skos:definition "Seventeen main questions across study characteristics, methods/cost analysis and results/reporting. Yes/Partially/No/Not Applicable/Unclear are appraisal responses. Do not present it as a manuscript-reporting standard." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/coi-appraisal-2023> ;
    cost:instrumentKind "appraisal_instrument" .

<https://w3id.org/uogto/costing-reporting/instrument/ghcc-2017> a cost:ReportingInstrument ;
    rdfs:label "GHCC Reference Case and Principles and Methods Reporting Checklist" ;
    skos:definition "Seventeen principles in four groups connect costing purpose, resource quantities, valuation, and transparent results. Principle identifiers are verified; the more detailed downloadable checklist rows have not all been independently transcribed." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/ghcc-2017> ;
    cost:instrumentKind "methods_reporting_reference_case" .

<https://w3id.org/uogto/costing-reporting/instrument/idsi-2016> a cost:ReportingInstrument ;
    rdfs:label "iDSI Reference Case for Economic Evaluation" ;
    skos:definition "Eleven principles pair methodological specifications with reporting standards. Context matters; policy defaults should be versioned jurisdiction profiles rather than universal engine constants." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/idsi-2016> ;
    cost:instrumentKind "methods_reporting_reference_case" .

<https://w3id.org/uogto/costing-reporting/instrument/immunisation-reporting-2020> a cost:ReportingInstrument ;
    rdfs:label "Reporting gaps in immunization costing studies: reporting checklist" ;
    skos:definition "GHCC-derived immunisation reporting profile adds vaccines, target populations, coverage and delivery configurations. Denominator definitions and whether vaccine/staff costs are included materially affect interpretation." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/immunisation-reporting-2020> ;
    cost:instrumentKind "sector_reporting_guideline" .

<https://w3id.org/uogto/costing-reporting/instrument/ispor-bia-2014> a cost:ReportingInstrument ;
    rdfs:label "ISPOR Budget Impact Analysis Good Practice II" ;
    skos:definition "Separate budget-holder framework covering eligible population, adoption, treatment mix, costs, scenarios, validation and reporting. Jurisdiction-specific BIA requirements remain applicable; CHEERS alone is insufficient." ;
    cost:hasVersion <https://w3id.org/uogto/costing-reporting/version/ispor-bia-2014> ;
    cost:instrumentKind "methods_reporting_reference_case" .

<https://w3id.org/uogto/costing-reporting/instrument/nhs-acg-2026> a cost:ReportingInstrument ;
    rdfs:label "NHS England Approved Costing Guidance" ;
    skos:definition "Annually versioned patient-level costing and National Cost Collection guidance. Include a separate England profile for cost quantum, classification, allocation, patient matching and reconciliation." ;
