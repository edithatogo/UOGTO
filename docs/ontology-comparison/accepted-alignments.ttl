@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix uogtoalign: <https://w3id.org/uogto/alignments/comparison#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

uogtoalign:accepted_alignments a owl:Ontology ;
    rdfs:label "UOGTO comparative ontology accepted alignments"@en ;
    dcterms:description "Accepted alignments supported by repository structure or scoped semantic review, generated from docs/ontology-comparison/mapping-review.csv."@en .

uogtoalign:mapping-0ab225257bfefe9b a uogtoalign:MappingAssertion ;
    uogtoalign:confidence 1.0 ;
    uogtoalign:mappingPredicate skos:narrowMatch ;
    uogtoalign:reviewRationale "Accepted because the checked-in UOGTO alignment module asserts the UOGTO term as a subclass of the external source term; recorded as a conservative narrow match rather than equivalence." ;
    uogtoalign:reviewStatus "accepted" ;
    uogtoalign:sourceTerm prov:Agent ;
    uogtoalign:uogtoTerm <https://w3id.org/uogto/core#Agent> .

uogtoalign:mapping-3dda61b5462ba5cc a uogtoalign:MappingAssertion ;
    uogtoalign:confidence 0.5615 ;
    uogtoalign:mappingPredicate skos:narrowMatch ;
    uogtoalign:reviewRationale "Accepted because the checked-in UOGTO alignment module asserts the UOGTO term as a subclass of the external source term; recorded as a conservative narrow match rather than equivalence." ;
    uogtoalign:reviewStatus "accepted" ;
    uogtoalign:sourceTerm prov:Entity ;
    uogtoalign:uogtoTerm <https://w3id.org/uogto/core#Outcome> .

uogtoalign:mapping-6796abf9f4fc3bfa a uogtoalign:MappingAssertion ;
    uogtoalign:confidence 0.62 ;
    uogtoalign:mappingPredicate skos:narrowMatch ;
    uogtoalign:reviewRationale "Accepted because the checked-in UOGTO alignment module asserts the UOGTO term as a subclass of the external source term; recorded as a conservative narrow match rather than equivalence." ;
    uogtoalign:reviewStatus "accepted" ;
    uogtoalign:sourceTerm prov:Activity ;
    uogtoalign:uogtoTerm <https://w3id.org/uogto/core#Action> .

uogtoalign:mapping-92ccda714e703a94 a uogtoalign:MappingAssertion ;
    uogtoalign:confidence 1.0 ;
    uogtoalign:mappingPredicate skos:narrowMatch ;
    uogtoalign:reviewRationale "Accepted because the checked-in UOGTO alignment module asserts the UOGTO term as a subclass of the external source term; recorded as a conservative narrow match rather than equivalence." ;
    uogtoalign:reviewStatus "accepted" ;
    uogtoalign:sourceTerm schema:Action ;
    uogtoalign:uogtoTerm <https://w3id.org/uogto/core#Action> .

prov:Activity skos:narrowMatch <https://w3id.org/uogto/core#Action> .

prov:Agent skos:narrowMatch <https://w3id.org/uogto/core#Agent> .

prov:Entity skos:narrowMatch <https://w3id.org/uogto/core#Outcome> .

schema:Action skos:narrowMatch <https://w3id.org/uogto/core#Action> .

